# Copy to .env. Only needed for private GitHub repositories and --ai-select.

# GitHub: private repositories, and a higher rate limit for public ones.
GITHUB_TOKEN=

# --ai-select: any OpenAI-compatible endpoint.
LLM_MODEL=
LLM_API_KEY=
# Leave empty for api.openai.com. For a local server, for example:
# LLM_BASE_URL=http://localhost:8080/v1
LLM_BASE_URL=
